{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/blog",
      "destination": "https://aov-booster-blog.vercel.app/blog"
    },
    {
      "source": "/blog/:path*",
      "destination": "https://aov-booster-blog.vercel.app/blog/:path*"
    }
  ],
  "routes": [
    {
      "src": "/blog(.*)",
      "dest": "https://aov-booster-blog.vercel.app/blog$1",
      "status": 200
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}