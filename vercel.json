{
  "rewrites": [
    {
      "source": "/blog",
      "destination": "https://aov-booster-blog.vercel.app/blog"
    },
    {
      "source": "/blog/:match*",
      "destination": "https://aov-booster-blog.vercel.app/blog/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}