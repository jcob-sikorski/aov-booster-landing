{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/blog/?$",
      "dest": "https://aov-booster-blog.vercel.app/",
      "check": true
    },
    {
      "src": "/blog/(.*)",
      "dest": "https://aov-booster-blog.vercel.app/$1",
      "check": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}